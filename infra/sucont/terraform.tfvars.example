# Copy to terraform.tfvars. Apply infra/foundation first, then this stack.
# state_bucket comes from the infra/bootstrap output (state_bucket_name).
state_bucket         = "CHANGE_ME_FROM_INFRA_BOOTSTRAP_OUTPUT"
state_region         = "sa-east-1"
foundation_state_key = "foundation/prod/terraform.tfstate"
aws_region           = "sa-east-1"

service_name      = "sucont"
docker_target     = "sucont"
container_port    = 3000
cpu               = 256
memory            = 512
health_check_path = "/health"
listener_priority = 200

environment_variables = {
  NODE_ENV = "production"
  PORT     = "3000"
  # IA via AWS Bedrock (keyless — usa a task role do ECS). Nao-secretos.
  #
  # O id NAO e livre: a task role so pode invocar o que a policy `-ecs-task-extra`
  # permite, que hoje e `inference-profile/global.anthropic.*` mais os
  # foundation-model `anthropic.*` e `openai.gpt-oss-*`. Um perfil `us.anthropic.*`
  # e negado (implicitDeny) e a chamada morre em AccessDenied — que NAO e falha
  # transitoria, entao a reserva tambem nao entra. Confira antes de aplicar:
  #   aws bedrock list-inference-profiles --region sa-east-1 \
  #     --query "inferenceProfileSummaries[?starts_with(inferenceProfileId,'global.anthropic')].inferenceProfileId"
  #   aws iam simulate-principal-policy \
  #     --policy-source-arn arn:aws:iam::<conta>:role/iefa-prod-ecs-task \
  #     --action-names bedrock:InvokeModelWithResponseStream \
  #     --resource-arns arn:aws:bedrock:sa-east-1:<conta>:inference-profile/<id>
  #
  # Perfil `global.` atende de sa-east-1: nao ha motivo para cruzar regiao.
  SUCONT_AI_PROVIDER = "bedrock"
  SUCONT_AI_MODEL    = "global.anthropic.claude-sonnet-4-6"
  SUCONT_AI_REGION   = "sa-east-1"

  # Tetos de consumo (ver AI-PROVIDERS.md). Por usuário, exceto TOKENS_PER_DAY
  # (por processo — com desired_count = N o teto efetivo é N x o configurado).
  SUCONT_AI_MAX_REQUESTS_PER_MINUTE = "12"
  SUCONT_AI_MAX_TOKENS_PER_MINUTE   = "120000"
  SUCONT_AI_MAX_TOKENS_PER_DAY      = "2000000"
}

secret_names = [
  "VITE_SUCONT_SUPABASE_URL",
  "VITE_SUCONT_SUPABASE_PUBLISHABLE_KEY",
  "SUCONT_SUPABASE_SECRET_KEY",
]

hosts = ["sucont.iefa.com.br"]

# Copy to terraform.tfvars. Apply infra/foundation first, then this stack.
# state_bucket comes from the infra/bootstrap output (state_bucket_name).
state_bucket         = "CHANGE_ME_FROM_INFRA_BOOTSTRAP_OUTPUT"
state_region         = "sa-east-1"
foundation_state_key = "foundation/prod/terraform.tfstate"
aws_region           = "sa-east-1"

service_name      = "sucont"
docker_target     = "sucont"
container_port    = 3000
cpu               = 256
memory            = 512
health_check_path = "/health"
listener_priority = 200

environment_variables = {
  NODE_ENV = "production"
  PORT     = "3000"
  # IA via AWS Bedrock (keyless — usa a task role do ECS). Nao-secretos.
  #
  # O id NAO e livre: a task role so pode invocar o que a policy `-ecs-task-extra`
  # permite, que hoje e `inference-profile/global.anthropic.*` mais os
  # foundation-model `anthropic.*` e `openai.gpt-oss-*`. Um perfil `us.anthropic.*`
  # e negado (implicitDeny) e a chamada morre em AccessDenied — que NAO e falha
  # transitoria, entao a reserva tambem nao entra.
  #
  # ATENCAO ao conferir: a FORMA do ARN depende do TIPO do id.
  #   - `global.anthropic.*` e inference profile (leva a conta no ARN):
  #       arn:aws:bedrock:sa-east-1:<conta>:inference-profile/<id>
  #   - `openai.gpt-oss-*` (hoje o valor da RESERVA) e foundation model (SEM conta):
  #       arn:aws:bedrock:sa-east-1::foundation-model/<id>
  # Simular um id com a forma do OUTRO tipo devolve implicitDeny e faz parecer que a
  # config esta errada quando nao esta. Liste conforme o tipo:
  #   aws bedrock list-foundation-models --region sa-east-1 \
  #     --query "modelSummaries[?starts_with(modelId,'openai.gpt-oss')].modelId"
  #   aws bedrock list-inference-profiles --region sa-east-1 \
  #     --query "inferenceProfileSummaries[?starts_with(inferenceProfileId,'global.anthropic')].inferenceProfileId"
  # E simule com a forma certa PARA CADA valor aplicado — primario e reserva usam
  # formas DIFERENTES de ARN, e usar a do outro devolve implicitDeny sobre uma
  # config correta:
  #   # primario (inference profile, COM conta)
  #   aws iam simulate-principal-policy \
  #     --policy-source-arn arn:aws:iam::<conta>:role/iefa-prod-ecs-task \
  #     --action-names bedrock:InvokeModelWithResponseStream \
  #     --resource-arns arn:aws:bedrock:sa-east-1:<conta>:inference-profile/global.anthropic.claude-opus-4-6-v1
  #   # reserva (foundation model, SEM conta)
  #   aws iam simulate-principal-policy \
  #     --policy-source-arn arn:aws:iam::<conta>:role/iefa-prod-ecs-task \
  #     --action-names bedrock:InvokeModelWithResponseStream \
  #     --resource-arns arn:aws:bedrock:sa-east-1::foundation-model/openai.gpt-oss-120b-1:0
  #
  # O SUFIXO NAO SEGUE REGRA — confira o id na conta, nao pelo padrao do vizinho.
  # Na MESMA geracao: `global.anthropic.claude-opus-4-6-v1` (com `-v1`) e
  # `global.anthropic.claude-sonnet-4-6` (sem sufixo). Id errado vira
  # ValidationException, que NAO e transitoria — a reserva nao entra e o app fica
  # sem IA.
  #
  # Estar na policy nao basta: o modelo tambem precisa estar HABILITADO na conta.
  # Em 2026-08-21, opus-5, opus-4-8, opus-4-7, sonnet-5 e fable-5 respondem
  # `AccessDeniedException: not available for this account`. Habilitados:
  # opus-4-6, opus-4-5, sonnet-4-6, sonnet-4-5, haiku-4-5 e gpt-oss-120b.
  #
  # Regiao: sa-east-1, a da stack — nao ha motivo para cruzar regiao.
  SUCONT_AI_PROVIDER = "bedrock"
  SUCONT_AI_MODEL    = "global.anthropic.claude-opus-4-6-v1"
  SUCONT_AI_REGION   = "sa-east-1"

  # Reserva: so entra ANTES do primeiro conteudo e so em falha TRANSITORIA
  # (429/5xx/throttling/timeout/queda de transporte). AccessDenied e erro de
  # schema propagam — trocar de provider so repetiria a falha. Nao e camada de
  # economia: e o que mantem o app respondendo quando o primario esta THROTTLED ou
  # FORA DO AR. Primario NEGADO (403) o app nao contorna — e config, nao capacidade.
  SUCONT_FALLBACK_AI_PROVIDER = "bedrock"
  SUCONT_FALLBACK_AI_MODEL    = "openai.gpt-oss-120b-1:0"
  SUCONT_FALLBACK_AI_REGION   = "sa-east-1"

  # Tetos de consumo (ver AI-PROVIDERS.md). Por usuário, exceto TOKENS_PER_DAY
  # (por processo — com desired_count = N o teto efetivo é N x o configurado).
  # Os numeros NAO foram redimensionados para o Opus — vieram da carga, nao do preco:
  # uma competencia do SAC-DGC sao ~69 UGs a ~15k tokens (~1,0M), entao 2M/dia cabe
  # uma competencia inteira com folga e corta a segunda. Com primario da familia Opus
  # o teto diario passa a ser tambem um teto de CUSTO, e o preco do Claude no Bedrock
  # nao esta verificado (ver AI-PROVIDERS.md) — reveja antes de assumir que e barato.
  SUCONT_AI_MAX_REQUESTS_PER_MINUTE = "12"
  SUCONT_AI_MAX_TOKENS_PER_MINUTE   = "120000"
  SUCONT_AI_MAX_TOKENS_PER_DAY      = "2000000"
}

secret_names = [
  "VITE_SUCONT_SUPABASE_URL",
  "VITE_SUCONT_SUPABASE_PUBLISHABLE_KEY",
  "SUCONT_SUPABASE_SECRET_KEY",
]

hosts = ["sucont.iefa.com.br"]

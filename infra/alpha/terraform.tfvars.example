# Copy to terraform.tfvars. Apply infra/foundation first, then this stack.
# state_bucket comes from the infra/bootstrap output (state_bucket_name).
state_bucket         = "CHANGE_ME_FROM_INFRA_BOOTSTRAP_OUTPUT"
state_region         = "sa-east-1"
foundation_state_key = "foundation/prod/terraform.tfstate"
aws_region           = "sa-east-1"

service_name      = "alpha"
docker_target     = "alpha"
container_port    = 8000
cpu               = 512
memory            = 1024
health_check_path = "/health"
listener_priority = 130

environment_variables = {
  NODE_ENV = "production"
  PORT     = "8000"
  # Timer semanal de atualização das fontes normativas. Ligar só depois da
  # primeira coleta manual conferida.
  ALPHA_SOURCES_REFRESH_ENABLED = "false"
}

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / DATABASE_URL vêm dos secrets do
# sisub (mesmo projeto Supabase, schema `alpha`) — ver .github/workflows/sync-secrets.yml.
#
# TODO(manutenibilidade): trocar por secrets próprios do α. Herdar do sisub
# significa que rotacionar a chave dele derruba o α, e impede dar ao α uma
# credencial de menor privilégio ou um pooler dimensionado para a carga dele.
secret_names = [
  "SUPABASE_URL",
  "SUPABASE_SERVICE_ROLE_KEY",
  "DATABASE_URL",
  "NVIDIA_API_KEY",
  "ALPHA_AI_API_KEY",
  "LANGCHAIN_API_KEY",
  "ALPHA_JOB_SECRET",
]


hosts = ["alpha.iefa.com.br"]

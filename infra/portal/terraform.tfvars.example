# Copy to terraform.tfvars. Apply infra/foundation first, then this stack.
# state_bucket comes from the infra/bootstrap output (state_bucket_name).
state_bucket         = "CHANGE_ME_FROM_INFRA_BOOTSTRAP_OUTPUT"
state_region         = "sa-east-1"
foundation_state_key = "foundation/prod/terraform.tfstate"
aws_region           = "sa-east-1"

service_name      = "portal"
docker_target     = "portal"
container_port    = 3000
cpu               = 256
memory            = 512
health_check_path = "/health"
listener_priority = 100

environment_variables = {
  NODE_ENV = "production"
  PORT     = "3000"

  # IA da redacao assistida de comunicacoes oficiais (/facilities/comunicacoes-oficiais).
  # Bedrock keyless pela task role do ECS. Nao-secretos.
  #
  # Os valores abaixo foram VERIFICADOS na conta 103256050857 em 2026-09-02, nao copiados:
  #   1. habilitacao (o perfil aparecer ACTIVE NAO basta) — `bedrock-runtime converse` de
  #      verdade: opus-4-6 e sonnet-4-6 respondem; opus-4-8 e opus-5 devolvem
  #      `AccessDeniedException: not available for this account`, mesmo listados ACTIVE;
  #   2. autorizacao da task role — `simulate-principal-policy` para
  #      `bedrock:InvokeModelWithResponseStream`: allowed no primario e na reserva.
  #      `bedrock:Converse`/`ConverseStream` dao implicitDeny e isso e ESPERADO: a policy
  #      `iefa-prod-ecs-task-extra` so concede InvokeModel*, e e por InvokeModel* que a
  #      Converse API autoriza. Simular a acao `Converse` faz config correta parecer errada;
  #   3. ponta a ponta com o schema real — `cd apps/portal && bun run test:ai`, que chama o
  #      modelo com o mesmo JSON Schema da redacao assistida e valida a volta com o Zod do
  #      boundary. Verde no opus-4-6 e no gpt-oss-120b; vermelho no opus-4-8 (item 1).
  #
  # A FORMA do ARN muda com o TIPO do id — `global.anthropic.*` e inference profile (ARN COM
  # conta) e `openai.gpt-oss-*` e foundation model (ARN SEM conta). Detalhes e os comandos
  # prontos estao em infra/sucont/terraform.tfvars.example e no AI-PROVIDERS.md.
  PORTAL_AI_PROVIDER = "bedrock"
  PORTAL_AI_MODEL    = "global.anthropic.claude-opus-4-6-v1"
  PORTAL_AI_REGION   = "sa-east-1"

  # Reserva: so entra ANTES do primeiro conteudo e so em falha TRANSITORIA. AccessDenied e
  # erro de schema propagam — trocar de provider repetiria a falha.
  PORTAL_FALLBACK_AI_PROVIDER = "bedrock"
  PORTAL_FALLBACK_AI_MODEL    = "openai.gpt-oss-120b-1:0"
  PORTAL_FALLBACK_AI_REGION   = "sa-east-1"

  # Tetos por usuario, exceto TOKENS_PER_DAY, que e por PROCESSO: o portal roda com
  # desired_count = 2, entao o teto diario efetivo e o DOBRO do numero abaixo.
  # Dimensionado pela carga real desta ferramenta, nao copiado do sucont: uma redacao e
  # ~1,5k tokens de entrada + ~1,5k de saida, entao 500k/dia/processo cabe ~160 documentos
  # por processo (~320 no total) — folga larga para um formulario que gera um documento por
  # clique, e teto de CUSTO com primario da familia Opus.
  PORTAL_AI_MAX_REQUESTS_PER_MINUTE = "10"
  PORTAL_AI_MAX_TOKENS_PER_MINUTE   = "60000"
  PORTAL_AI_MAX_TOKENS_PER_DAY      = "500000"
}

secret_names = [
  "VITE_IEFA_SUPABASE_URL",
  "VITE_IEFA_SUPABASE_PUBLISHABLE_KEY",
  "IEFA_SUPABASE_SECRET_KEY",
]

# Host-based routing on the shared ALB (requires a certificate on the foundation).

# User-facing SSR app: two tasks so a Spot reclamation never leaves the portal down.
# Internal/low-traffic services stay on the module default of 1.
desired_count = 2

# Alternative to a second Spot task: pin one on-demand task instead (≈2x the
# hourly rate of Spot, but immune to capacity reclamation).
# fargate_on_demand_base = 1

hosts = ["portal.iefa.com.br"]

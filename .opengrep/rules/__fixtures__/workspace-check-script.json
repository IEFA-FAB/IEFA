// Casos de teste de `.opengrep/rules/workspace-check-script.yaml`. Não é package.json de verdade:
// os comentários existem só para as anotações do `opengrep test`.
{
  "scripts": {
    // ruleid: workspace-check-script
    "check": "biome check",
    // ruleid: workspace-check-script
    "check" : "anything",
    // ok: workspace-check-script
    "typecheck": "bun check",
    // ok: workspace-check-script
    "lint": "biome check && bun ../../scripts/lint-tailwind.ts sisub",
    // ok: workspace-check-script
    "check:deploy": "bun scripts/generate-deploy-artifacts.ts --check"
  }
}

// Casos de teste de `.opengrep/rules/bun-check-script.yaml`. Não é package.json de verdade: os
// comentários existem só para as anotações do `opengrep test`.
{
  "scripts": {
    // ruleid: bun-check-in-script
    "typecheck": "bun check",
    // ruleid: bun-check-in-script
    "typecheck:src": "fumadocs-mdx && bun check -p .",
    // ruleid: bun-check-in-script
    "typecheck:spaces": "bun  check",
    // ruleid: bun-check-in-script
    "typecheck:tab": "bun	check",
    // ok: bun-check-in-script
    "typecheck:ok": "bun --check",
    // ok: bun-check-in-script
    "typecheck:wrapper": "bun ../../scripts/typecheck.ts",
    // ok: bun-check-in-script
    "other": "bun check:types",
    // ok: bun-check-in-script
    "docs": "fumadocs-mdx && bun --check",
    // ok: bun-check-in-script
    "check": "biome check"
  }
}

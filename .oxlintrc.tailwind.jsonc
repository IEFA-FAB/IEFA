{
  // Lint de Tailwind (@shadcn/lint). Roda por `scripts/lint-tailwind.ts`, que confere os
  // avisos contra `tailwind-lint-baseline.json` de cada app. Nome fora do padrão de propósito:
  // o react-doctor adota um `.oxlintrc.json` da raiz e passaria a rodar estas regras também.
  "plugins": [],
  "categories": { "correctness": "off" },
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": ["**/*.gen.ts", "**/*.test.ts", "**/*.test.tsx", "**/*.d.ts"],
  "rules": {
    // Classe que não gera CSS nenhum: erro de digitação, variante inexistente, plugin não carregado.
    "shadcn/no-unknown-classes": "error",
    // Paleta crua (`bg-blue-600`) em vez de token do tema. Dívida medida pelo baseline.
    // `text-label`, `text-hero`… e `shadow-hard-*` são classes soltas em `@layer utilities`
    // (portal, contrate, forms, rumaer), e o prefixo faz o linter lê-las como cor. Não viram
    // `@utility`: soltas, vêm depois de todo utilitário gerado e vencem qualquer conflito no
    // elemento; como `@utility` passariam a perder para `tracking-*`/`text-[10px]` vizinhos.
    "shadcn/no-raw-colors": [
      "warn",
      { "allow": ["text-hero", "text-display", "text-headline", "text-label", "shadow-hard-sm", "shadow-hard-md", "shadow-hard-lg"] }
    ],
    // Valor fora da escala (`p-[13px]`, `text-[10px]`). Dimensão de layout (largura, margem,
    // posição) passa: é onde o valor exato costuma ser legítimo. Dívida medida pelo baseline.
    // A mensagem aponta o contrato: trocar `text-[10px]` por um degrau cru só mudaria o nome da
    // dívida — os STYLE_CONTRACTs pedem a classe semântica.
    "shadcn/no-arbitrary-values": [
      "warn",
      {
        "allow": ["layout"],
        "message": "\"{{className}}\" é valor fora da escala (o mais próximo nela: {{suggestions|nenhum}}). Tipografia, tracking e sombra vão pela classe semântica do STYLE_CONTRACT do app — trocar por um degrau cru só renomeia a dívida."
      }
    ],
    // `className` num componente de `components/ui` só posiciona (layout: margem, largura,
    // flex, posição). Aparência vem de variante — se o design pede uma que não existe, ela
    // nasce no primitivo, não num `className` repetido em cada tela. Contratos por slot abrem o
    // que o slot existe para receber. Dívida medida pelo baseline.
    // `tabular-nums` e `font-mono` passam em todo lugar: dizem como o DADO se lê (valor que
    // alinha em coluna, código, NUP, CNPJ), não como o componente se parece. Contrato substitui
    // o `allow` geral em vez de somar, por isso eles se repetem em cada um.
    "shadcn/no-restyle": [
      "warn",
      {
        "allow": ["layout", "tabular-nums", "font-mono"],
        "contracts": [
          {
            // Moldura: o respiro interno e o texto corrido do conteúdo são decisão da tela; fundo,
            // borda e sombra seguem sendo do primitivo.
            "pattern": "^(Card|Sheet|Dialog|AlertDialog|Drawer|Popover)(Header|Content|Footer)$|^TabsContent$",
            "allow": ["layout", "spacing", "typography", "text-color", "tabular-nums", "font-mono"]
          },
          {
            // Texto (CardTitle, AlertDescription, DropdownMenuLabel…): escala e cor DO TEXTO, e o
            // `gap` de quando o título leva ícone. Fundo, borda e anel seguem sendo do primitivo.
            // `text-color` também cobre as classes semânticas `text-subheading`/`text-hint`…
            "pattern": "(Title|Description|Label)$",
            "allow": ["layout", "typography", "text-color", "gap", "tabular-nums", "font-mono"]
          },
          {
            // Célula: alinhamento numérico, fonte mono, respiro e cor de status do texto.
            "pattern": "^Table(Cell|Head)$",
            "allow": ["layout", "spacing", "typography", "text-color"]
          },
          {
            // Linha: o fundo marca estado do dado (pendente, vencido, selecionado) e a linha de
            // cabeçalho desliga o hover.
            "pattern": "^TableRow$",
            "allow": ["layout", "bg-color"]
          },
          {
            // Esqueleto imita a forma do que vai carregar: avatar redondo, card arredondado.
            "pattern": "^Skeleton$",
            "allow": ["layout", "rounded"]
          },
          {
            // Contêineres de empilhamento: a densidade entre os filhos é decisão da tela.
            "pattern": "^(FieldGroup|Field|ItemGroup)$|^ScrollArea$",
            "allow": ["layout", "spacing"]
          },
          {
            // Gatilhos sem visual próprio: o wrapper não aplica classe nenhuma, quem desenha é o
            // elemento que a tela passa. `SelectTrigger`, `TabsTrigger` e afins têm visual e
            // não entram aqui.
            "pattern": "^(Tooltip|Popover|HoverCard|Collapsible|Dialog|AlertDialog|Sheet|Drawer|DropdownMenu)Trigger$",
            "allow": ["*"]
          }
        ]
      }
    ]
  },
  // A última override que casa com o arquivo decide as opções da regra: a geral vem antes.
  "overrides": [
    {
      // Primitivos do design system definem o próprio visual: valor exato e restyle ali são implementação.
      "files": ["apps/*/src/components/ui/**"],
      "rules": { "shadcn/no-arbitrary-values": "off", "shadcn/no-restyle": "off" }
    },
    {
      // Ganchos sem CSS: `nodrag`/`nopan` são lidos pelo React Flow; `qr-*` e
      // `main-content-surface` marcam elementos; `recharts-*` é classe do Recharts.
      "files": ["apps/sisub/src/**", "apps/sucont/src/**"],
      "rules": {
        "shadcn/no-unknown-classes": ["error", { "allow": ["nodrag", "nopan", "qr-reader", "qr-box", "main-content-surface", "recharts-*"] }]
      }
    },
    {
      // Documentos de impressão: o CSS vem do `<style>` do próprio componente, fora do tema.
      "files": [
        "apps/sisub/src/components/features/diner/snack-requests/SnackRequestPrint.tsx",
        "apps/sisub/src/components/features/local/snack-requests/SnackLabels.tsx",
        "apps/sisub/src/components/features/local/planning/WeeklyMenuPrint.tsx",
        "apps/sisub/src/components/features/local/planning/OccasionMenuPrint.tsx",
        "apps/sisub/src/components/features/local/planning/MenuPrintParts.tsx",
        "apps/sisub/src/components/features/shared/RecipeTechnicalSheetPrint.tsx"
      ],
      "rules": {
        "shadcn/no-unknown-classes": ["error", { "allow": ["anexo-e-*", "snack-label", "snack-label-*", "snack-labels-*", "cardapio-*", "ftp-*"] }]
      }
    }
  ]
}

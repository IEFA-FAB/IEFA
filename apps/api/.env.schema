# api IEFA — variáveis de ambiente
# @generateTypes(lang=ts, path=env.d.ts)
# @defaultSensitive=false
# ---

# Porta do servidor HTTP
# @optional
# @type=number
API_PORT=3000

# URL do projeto Supabase
# @required
# @type=string(startsWith=https)
API_SUPABASE_URL=

# Service role key do Supabase — somente servidor
# @required
# @sensitive
API_SUPABASE_SERVICE_ROLE_KEY=

# Segredo exigido no header x-admin-secret dos endpoints administrativos
# @required
# @sensitive
ADMIN_SECRET=

# Base URL da API Verified by GS1 (CNP — GS1 Brasil); sem ela o lookup GTIN responde 503
# @type=string(startsWith=https)
GS1_VBG_API_URL=

# API key do Verified by GS1
# @sensitive
GS1_VBG_API_KEY=

# URL da publicação GPC (JSON, export do GPC Browser) usada pelo sync:gpc
# @type=string(startsWith=https)
GS1_GPC_PUBLICATION_URL=

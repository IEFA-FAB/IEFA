{
  "name": "@iefa/api",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "sync:food-catmat": "bun scripts/run-compras-food-sync.ts",
    "sync:nutrition-reference": "bun scripts/run-nutrition-reference-sync.ts",
    "sync:gpc": "bun scripts/run-gpc-import.ts",
    "test": "bun test --no-env-file src",
    "test:integration": "bun test --no-env-file --timeout 30000 tests/integration",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "bun ../../scripts/typecheck.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@iefa/agent-web": "workspace:*",
    "@iefa/compras-api": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@iefa/sisub-domain": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.11",
    "@supabase/supabase-js": "^2.117.3",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iefa/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}

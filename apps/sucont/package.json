{
  "name": "sucont",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "test": "bun test --no-env-file src",
    "test:e2e": "bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui",
    "purge:test-fixtures": "bun run scripts/purge-test-fixtures.ts",
    "harness:build": "vite build --config harness/vite.config.ts --outDir dist-harness",
    "harness:serve": "vite preview --config harness/vite.config.ts --outDir dist-harness --port 4180 --strictPort",
    "harness:shot": "bun run harness/screenshot.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@iefa/agent-web": "workspace:*",

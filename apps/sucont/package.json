    "@tanstack/react-store": "^0.11.1",
    "@tanstack/store": "^0.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.40.0",
    "motion": "^13.2.0",
    "nitro": "^3.0.260903-beta",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",

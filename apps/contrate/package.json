{
  "name": "@iefa/contrate",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --no-env-file $(find src -name '*.test.ts' -print)",
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "serve": "bunx --bun vite preview",
    "format": "biome format",
    "lint": "biome lint && bun ../../scripts/lint-tailwind.ts contrate",
    "check": "biome check",
    "typecheck": "bun --check",
    "validate-env": "bun run src/env.ts",
    "test:e2e": "CONTRATE_RUN_E2E=true bunx playwright test"
  },

{
  "name": "@iefa/portal",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --no-env-file $(find src -name '*.test.ts' -print)",
    "test:ai": "PORTAL_RUN_AI_SMOKE=true bun test --no-env-file src/test/ai/",
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "serve": "bunx --bun vite preview",
    "format": "biome format",
    "lint": "biome lint && bun ../../scripts/lint-tailwind.ts portal",
    "check": "biome check",
    "typecheck": "bun ../../scripts/typecheck.ts",
    "validate-env": "bun run src/env.ts"
  },
  "dependencies": {

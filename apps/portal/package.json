    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "iconoir-react": "^7.12.1",
    "motion": "^13.5.1",
    "nitro": "^3.0.260903-beta",

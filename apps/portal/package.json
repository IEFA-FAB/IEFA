    "@iefa/auth-kit": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@iefa/pbac": "workspace:*",
    "@iefa/supabase-kit": "workspace:*",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.63.0",
    "@tanstack/ai-react": "^0.29.3",
    "@tanstack/react-devtools": "^0.10.13",

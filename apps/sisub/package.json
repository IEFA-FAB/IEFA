{
  "name": "@iefa/sisub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "serve": "bunx --bun vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsgo --noEmit",
    "validate-env": "bun run src/lib/env.ts",
    "test": "bun run test:unit",
    "test:unit": "SISUB_RUN_INTEGRATION=false vitest run --config vitest.config.ts",
    "test:integration": "SISUB_RUN_INTEGRATION=true SISUB_INTEGRATION_REQUIRED=true vitest run --config vitest.config.ts",
    "test:integration:gate": "SISUB_RUN_INTEGRATION=true SISUB_INTEGRATION_REQUIRED=true vitest run --config vitest.config.ts --no-file-parallelism src/test/operations/stock-ledger.operations.test.ts src/test/operations/receiving.operations.test.ts src/test/operations/monthly-closing.operations.test.ts src/test/operations/inventory-cycle.e2e.operations.test.ts src/test/operations/budget-execution.operations.test.ts",
    "test:integration:janitor": "bun run scripts/purge-test-fixtures.ts",
    "test:ai": "SISUB_RUN_AI_SMOKE=true vitest run --config vitest.config.ts src/test/ai",
    "test:e2e": "bunx playwright test",
    "test:e2e:ci": "bunx playwright test --project=chromium e2e/tests/smoke.spec.ts e2e/tests/auth.spec.ts e2e/tests/navigation.spec.ts e2e/tests/authz.spec.ts",
    "test:e2e:full": "ALL_BROWSERS=true bunx playwright test",
    "test:e2e:ui": "bunx playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@iefa/agent-web": "workspace:*",
    "@iefa/ai-provider": "workspace:*",
    "@iefa/auth-kit": "workspace:*",
    "@iefa/database": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@iefa/pbac": "workspace:*",
    "@iefa/sisub-domain": "workspace:*",
    "@iefa/supabase-kit": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@paper-design/shaders-react": "^0.0.80",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.43.1",
    "@tanstack/ai-client": "^0.23.1",
    "@tanstack/ai-react": "^0.19.1",
    "@tanstack/hotkeys": "^0.8.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.22",
    "@tanstack/react-router-ssr-query": "^1.167.1",

{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/.opengrep/rules/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/database/supabase/migrations/**"
      ]
    },
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/.opengrep/rules/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/database/supabase/migrations/**"
      ]
    }
  }
}

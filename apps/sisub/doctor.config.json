{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      ".output/**",
      "**/.output/**",
      "dist/**",
      "**/dist/**",
      "dist-ssr/**",
      "build/**",
      ".nitro/**",
      ".vinxi/**",
      ".tanstack/**",
      "coverage/**",
      "**/*.gen.ts"
    ],
    "overrides": [
      {
        "files": ["src/hooks/ui/usePersistentState.ts", "src/hooks/features/useChatSession.ts"],
        "rules": ["react-doctor/no-adjust-state-on-prop-change"]
      }
    ]
  }
}

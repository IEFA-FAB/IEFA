{
  "name": "@iefa/alpha",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "ingest": "bun run ingest-local.ts",
    "ingest:all": "bash ingest-all.sh",
    "ingest:agu": "bun run src/cli/ingest-agu.ts",
    "lint": "biome check src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test --no-env-file",
    "eval": "bun run src/eval/run-eval.ts",
    "embed:backfill": "bun run src/cli/backfill-embeddings.ts",
    "rada:fetch": "bun run src/cli/rada.ts fetch",
    "rada:build": "bun run src/cli/rada.ts build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1149.0",
    "@hono/zod-validator": "^0.9.1",
    "@iefa/agent-web": "workspace:*",
    "@iefa/ai-provider": "workspace:*",
    "@iefa/alpha-client": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@iefa/pbac": "workspace:*",
    "@iefa/supabase-kit": "workspace:*",
    "@langchain/aws": "^1.4.6",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.21",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.6",
    "@langchain/openai": "^1.6.2",
    "@supabase/supabase-js": "^2.117.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iefa/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}

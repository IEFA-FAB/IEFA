{
  "name": "@iefa/alpha",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "ingest": "bun run ingest-local.ts",
    "ingest:all": "bash ingest-all.sh",
    "ingest:agu": "bun run src/cli/ingest-agu.ts",
    "lint": "biome check src/",
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "eval": "bun run src/eval/run-eval.ts",
    "embed:backfill": "bun run src/cli/backfill-embeddings.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1109.0",
    "@hono/zod-validator": "^0.9.0",
    "@iefa/agent-web": "workspace:*",
    "@iefa/ai-provider": "workspace:*",
    "@iefa/alpha-client": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@langchain/aws": "^1.4.3",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.6",
    "@supabase/supabase-js": "^2.112.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.1",
    "pg": "^8.23.0",
    "unpdf": "^1.8.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iefa/tsconfig": "workspace:*",
    "@types/bun": "^1.4.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^11.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  }
}

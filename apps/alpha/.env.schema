# ai / RAG — variáveis de ambiente
# @generateTypes(lang=ts, path=env.d.ts)
# @defaultSensitive=false
# ---

# ── Supabase ──────────────────────────────────────────────────────────────────
# Mesmo projeto do sisub, schema `alpha`. Em produção, herdado dos secrets do
# sisub — ver sync-secrets.yml. TODO: secrets próprios do α para isolamento.

# @required
# @type=string(startsWith=https)
SUPABASE_URL=

# @required
# @sensitive
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão PostgreSQL direta (para LangGraph checkpointer)
# @required
# @sensitive
DATABASE_URL=

# ── IA — AWS Bedrock (padrão) ─────────────────────────────────────────────────
# Autenticação keyless pela cadeia de credenciais da AWS: task role do ECS em
# produção, profile local em desenvolvimento. Sem API key.

# Id do modelo ou do inference profile. Sem default: cravar um id que pode não
# existir na região seria pior do que exigir a escolha.
# @required
ALPHA_AI_MODEL=

# @optional
ALPHA_AI_PROVIDER=bedrock

# @optional
ALPHA_AI_REGION=sa-east-1

# Titan Text Embeddings V2 — 1024 dimensões, que é o que o schema fixa.
# @optional
ALPHA_EMBEDDING_PROVIDER=bedrock
# @optional
ALPHA_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Modelo de rerank do Bedrock. Vazio desliga o rerank (ordenação fica a do RRF).
# @optional
ALPHA_RERANK_MODEL=

# ── NVIDIA NIM — legado, só se ALPHA_*_PROVIDER=nvidia ────────────────────────

# @optional
# @sensitive
NVIDIA_API_KEY=

# Chave do provedor do chat principal do Alpha (pode reutilizar a mesma chave do NVIDIA_API_KEY)
# @optional
# @sensitive
ALPHA_AI_API_KEY=

# @required
# @type=string(startsWith=https)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Modelos ───────────────────────────────────────────────────────────────────

# @optional
LLM_MODEL=openai/gpt-oss-120b

# @optional
EMB_MODEL=baai/bge-m3

# Prefixo aplicado à query antes de gerar embedding
# @optional
EMB_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# @optional
EMB_TRUNCATE=END

# @optional
# @type=boolean
EMB_NORMALIZE=true

# @optional
# @type=number
EMB_BATCH_SIZE=128

# ── Reranker ──────────────────────────────────────────────────────────────────

# Multilingual PT suportado — MIRACL 26 langs
# @optional
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2

# @optional
# @type=number
RERANK_TOP_N=5

# Score mínimo do reranker para incluir chunk
# @optional
# @type=number
RERANK_THRESHOLD=0.45

# ── Hiperparâmetros de busca híbrida ─────────────────────────────────────────

# @optional
# @type=number
K_SEM=4

# @optional
# @type=number
K_KEYWORD=6

# @optional
# @type=number
RRF_K=60

# ── Servidor ──────────────────────────────────────────────────────────────────

# @optional
# @type=number
PORT=3001

# ── LangSmith (observabilidade opcional) ─────────────────────────────────────

# @optional
# @sensitive
LANGCHAIN_API_KEY=

# @optional
# @type=boolean
LANGCHAIN_TRACING_V2=true

# @optional
LANGCHAIN_PROJECT=alpha-aci

# ── Jobs internos ─────────────────────────────────────────────────────────────

# Segredo do agendador que chama POST /internal/jobs/sources/refresh
# @optional
# @sensitive
ALPHA_JOB_SECRET=

# Liga o timer semanal de atualização das fontes normativas
# @optional
# @type=boolean
ALPHA_SOURCES_REFRESH_ENABLED=false

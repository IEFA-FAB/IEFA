# Supabase — MESMO projeto do sisub, schema `alpha`.
# Migrations em packages/database/supabase/migrations/.
# Em produção estes três valores vêm dos secrets do sisub
# (VITE_SISUB_SUPABASE_URL / SISUB_SUPABASE_SECRET_KEY / SISUB_DATABASE_URL);
# ver .github/workflows/sync-secrets.yml.
#
# O projeto Supabase antigo do α (fjnysdiusivrffprcdus) foi descontinuado — o
# corpus foi migrado por packages/database/scripts/migrate-alpha-corpus.sh.
SUPABASE_URL=https://jgigqdpdjgnnuwajtayh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.jgigqdpdjgnnuwajtayh.supabase.co:5432/postgres

# NVIDIA NIM — LLM + Embeddings + Reranker (via @langchain/openai)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-120b
EMB_MODEL=baai/bge-m3
EMB_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
EMB_TRUNCATE=END
EMB_NORMALIZE=true
EMB_BATCH_SIZE=128

# Reranker NVIDIA — multilingual (PT suportado — MIRACL 26 langs)
NVIDIA_RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANK_TOP_N=5
# Rate limit trial: ~40 req/min (sem limite diário publicado)

# Hiperparâmetros híbrido
K_SEM=4
K_KEYWORD=6
RRF_K=60

# LangSmith
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=atlas-aci

# Jobs internos
ALPHA_JOB_SECRET=
ALPHA_SOURCES_REFRESH_ENABLED=false

{
  "name": "@iefa/assignment-selection",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "bunx --bun vite build",
    "serve": "bunx --bun vite preview",
    "format": "biome format",
    "lint": "biome lint && bun ../../scripts/lint-tailwind.ts assignment-selection",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "validate-env": "bun run src/env.ts",
    "test": "ASSIGNMENT_SELECTION_RUN_INTEGRATION=false vitest run --config vitest.config.ts",
    "test:integration": "ASSIGNMENT_SELECTION_RUN_INTEGRATION=true ASSIGNMENT_SELECTION_INTEGRATION_REQUIRED=true vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@iefa/agent-web": "workspace:*",
    "@iefa/auth-kit": "workspace:*",
    "@iefa/database": "workspace:*",
    "@iefa/legal-kit": "workspace:*",
    "@iefa/pbac": "workspace:*",
    "@iefa/supabase-kit": "workspace:*",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "nitro": "^3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iefa/tsconfig": "workspace:*",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "postgres": "^3.4.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}

{
  "name": "@iefa/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core.ts",
    "./generated": "./src/generated.ts",
    "./sisub": "./src/sisub.ts",
    "./compras-gov": "./src/compras-gov.ts",
    "./portal": "./src/portal.ts",
    "./journal": "./src/journal.ts",
    "./forms": "./src/forms.ts",
    "./rumaer": "./src/rumaer.ts",
    "./assignment-selection": "./src/assignment-selection.ts",
    "./sucont": "./src/sucont.ts",
    "./saram-link": "./src/saram-link.ts",
    "./documents": "./src/documents.ts",
    "./drizzle/sisub": "./drizzle/sisub.ts",
    "./postgres-pool": "./src/postgres-pool.ts"
  },
  "scripts": {
    "generate": "bun run db:types",
    "db:link": "bun run scripts/supabase-schemas.ts link",
    "db:types": "bun run scripts/supabase-schemas.ts types",
    "db:push": "bunx supabase db push",
    "db:pull": "bun run scripts/supabase-schemas.ts pull",
    "db:diff": "bun run scripts/supabase-schemas.ts diff",
    "db:reset": "bunx supabase db reset",
    "db:migrations": "bunx supabase migration list",
    "db:repair:applied": "bunx supabase migration repair --status applied",
    "db:repair:reverted": "bunx supabase migration repair --status reverted",
    "db:drizzle:pull": "bunx drizzle-kit pull && bun run scripts/patch-drizzle-pull.ts",
    "audit:rls": "bun run scripts/audit-rls.ts",
    "lint": "biome check .",
    "test": "bun test --no-env-file $(find src scripts -name '*.test.ts' -print)",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@iefa/tsconfig": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "supabase": "2.117.0",
    "typescript": "^7.0.2"
  }
}

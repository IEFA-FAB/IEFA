    "apps/sisub-mcp": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.ts"]
    },
    "apps/docs": {
      "entry": ["src/router.tsx", "src/start.ts", "vite.config.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/ai-provider": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.ts"]
    },
    "packages/agent-web": {
      "entry": ["src/index.ts", "src/server/index.ts", "src/**/*.test.{ts,tsx}"],

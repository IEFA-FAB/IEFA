{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreDependencies": [
    "@opentelemetry/exporter-trace-otlp-http",
    "@opentelemetry/resources",
    "@opentelemetry/sdk-trace-node",
    "@opentelemetry/semantic-conventions",
    "@tailwindcss/typography",
    "react-doctor",
    "tailwindcss",
    "tslib",
    "tw-animate-css"
  ],
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/portal": {
      "entry": ["src/client.tsx", "src/server.ts", "src/router.tsx", "vite.config.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/sisub": {
      "entry": [
        "src/client.tsx",
        "src/server.ts",
        "src/router.tsx",
        "src/lib/observability/nitro-otel.ts",
        "routes/**/*.ts",
        "vite.config.ts",
        "src/**/*.test.{ts,tsx}",
        "src/lib/observability/nitro-asset-404.ts",
        "src/lib/nitro-build-id.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "routes/**/*.ts"],
      "ignore": ["src/server/gtin.fn.ts", "src/server/gtin-specification.fn.ts", "src/components/features/global/gtin/GtinScannerField.tsx"],
      "vite": false
    },
    "apps/rumaer": {
      "entry": ["src/client.tsx", "src/server.ts", "src/router.tsx", "vite.config.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/forms": {
      "entry": ["src/client.tsx", "src/server.ts", "src/router.tsx", "vite.config.ts", "src/**/*.test.{ts,tsx}"],

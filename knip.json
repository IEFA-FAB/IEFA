    "apps/sucont": {
      "entry": ["src/server.ts", "src/router.tsx", "routes/**/*.ts", "vite.config.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "routes/**/*.ts"]

    "packages/legal-kit": {
      "entry": ["src/contact.ts", "src/index.ts", "src/react.tsx", "src/**/*.test.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/alpha-client": {
      "entry": ["src/access.ts", "src/demand/index.ts", "src/**/*.test.ts"],

{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!*.md"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**", "build/**"],
      "env": ["VITE_*", "NODE_ENV"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.*", "!*.md", "!e2e/**", "!tests/**", "!src/test/**", "!playwright.config.*", "!vitest.config.*"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/biome.json", "$TURBO_ROOT$/.oxlintrc.tailwind.jsonc", "$TURBO_ROOT$/scripts/lint-tailwind.ts"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/typecheck.ts"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/bunfig.toml"],
      "outputs": [],
      "env": [
        "SISUB_DATABASE_URL",
        "SISUB_RUN_INTEGRATION",
        "SISUB_INTEGRATION_REQUIRED",
        "VITE_SISUB_SUPABASE_URL",
        "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY",
        "SISUB_SUPABASE_SECRET_KEY"
      ]
    },
    "test:unit": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/bunfig.toml"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "outputs": [],
      "env": [
        "API_RUN_INTEGRATION",
        "API_SUPABASE_URL",
        "API_SUPABASE_SERVICE_ROLE_KEY",
        "ADMIN_SECRET",
        "SISUB_DATABASE_URL",
        "SISUB_RUN_INTEGRATION",
        "SISUB_INTEGRATION_REQUIRED",
        "VITE_SISUB_SUPABASE_URL",
        "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY",
        "SISUB_SUPABASE_SECRET_KEY"
      ]
    },
    "test:e2e": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI", "SISUB_RUN_E2E", "ALL_BROWSERS", "VITE_SISUB_SUPABASE_URL", "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY", "SISUB_SUPABASE_SECRET_KEY", "E2E_*"]
    },
    "test:e2e:ci": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI", "SISUB_RUN_E2E", "ALL_BROWSERS", "VITE_SISUB_SUPABASE_URL", "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY", "SISUB_SUPABASE_SECRET_KEY", "E2E_*"]
    },
    "test:e2e:full": {
      "cache": false,
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["CI", "SISUB_RUN_E2E", "ALL_BROWSERS", "VITE_SISUB_SUPABASE_URL", "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY", "SISUB_SUPABASE_SECRET_KEY", "E2E_*"]
    },
    "test:e2e:ui": {
      "cache": false,
      "persistent": true,
      "env": ["CI", "SISUB_RUN_E2E", "ALL_BROWSERS", "VITE_SISUB_SUPABASE_URL", "VITE_SISUB_SUPABASE_PUBLISHABLE_KEY", "SISUB_SUPABASE_SECRET_KEY", "E2E_*"]
    },
    "generate": {
      "cache": false,
      "outputs": ["src/types.gen.ts", "src/generated.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

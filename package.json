{
  "name": "iefa",
  "private": true,
  "packageManager": "bun@1.4.0",
  "overrides": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tanstack/query-core": "5.102.4",
    "ws": "^8.21.3",
    "protobufjs": "^7.6.5",
    "js-yaml": "^4.3.1",
    "fast-uri": "^3.1.5",
    "tar": "^7.5.22",
    "qs": "^6.15.3",
    "ip-address": "^10.5.0",
    "body-parser": "^2.3.0",
    "@hono/node-server": ">=1.19.15",
    "launch-editor": "^2.14.1",
    "shell-quote": "^1.10.0",
    "lodash": "^4.18.1",
    "langsmith": ">=0.8.11 <1.0.0",
    "tmp": "^0.2.7",
    "undici": ">=8.9.0 <9.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "sisub:dev": "bun --cwd ./apps/sisub dev",
    "sisub:test:e2e": "turbo run test:e2e --filter=@iefa/sisub",
    "sisub-mcp:dev": "bun --cwd ./apps/sisub-mcp dev",
    "sisub-mcp:start": "bun --cwd ./apps/sisub-mcp start",
    "portal:dev": "bun --cwd ./apps/portal dev",
    "rumaer:dev": "bun --cwd ./apps/rumaer dev",
    "assignment-selection:dev": "bun --cwd ./apps/assignment-selection dev",
    "api:dev": "bun --cwd ./apps/api dev",
    "forms:dev": "bun --cwd ./apps/forms dev",
    "5s:dev": "VITE_APP_TENANT=cinco-s bun --cwd ./apps/forms dev -- --port 3002",
    "docs:dev": "bun --cwd ./apps/docs dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "fix": "biome check --write .",
    "check": "biome check . && bun run typecheck",
    "ci": "bun run lint && bun run typecheck",
    "clean": "bunx turbo run clean && rm -rf node_modules .turbo",
    "clean:cache": "rm -rf .turbo node_modules/.cache",
    "knip": "knip",
    "generate:deploy": "bun scripts/generate-deploy-artifacts.ts",
    "check:deploy": "bun scripts/generate-deploy-artifacts.ts --check",
    "check:security-headers": "bun scripts/check-security-headers.ts",
    "upgrade": "bun update --latest",
    "gen-all-types": "turbo run generate",
    "commit": "bun run format:check && bunx turbo run lint typecheck && cz",
    "prepare": "husky",
    "quicksave": "git add . && git commit -m \"chore(root): wip unstable\""
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "react-doctor": "^0.9.12",
    "turbo": "^2.10.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
